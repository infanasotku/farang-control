environments:
  prod:
    values:
      - env: prod
      - namespace: farang-control
      - secretsFile: deploy/secrets/prod/common.secrets.yaml
  test:
    values:
      - env: test
      - namespace: farang-control-test
      - secretsFile: deploy/secrets/test/common.secrets.yaml

---

helmDefaults:
  kubeContext: kubernetes-admin@kubernetes
  wait: true
  timeout: 300
  atomic: true
  createNamespace: true

releases:
  - name: migration
    namespace: {{ .Environment.Values.namespace }}
    labels:
      svc: migration
    atomic: false
    waitForJobs: true
    chart: ./charts/migration
    values:
      - deploy/values/common/common.values.yaml
      - deploy/values/common/migration.values.yaml
      - deploy/values/{{ .Environment.Name }}/common.values.yaml
      - deploy/values/{{ .Environment.Name }}/migration.values.yaml
    set:
      - name: environment
        value: {{ .Environment.Name }}
      - name: container.tag
        value: {{ printf "%v" (required "tag is required; pass --state-values-set tag=<value>" (index .Environment.Values "tag")) }}
    hooks:
      - events: ["prepare"]
        command: bash
        args:
          - -c
          - |
            set -e
            sops -d {{ .Environment.Values.secretsFile }} > charts/migration/temp-secrets.yaml
      - events: ["cleanup"]
        command: bash
        args:
          - -c
          - |
            set -e
            rm -f charts/migration/temp-secrets.yaml
            rm -f charts/migration/Chart.lock
            rm -rf charts/migration/charts

  - name: api
    namespace: {{ .Environment.Values.namespace }}
    labels:
      svc: api
    chart: ./charts/api
    values:
      - deploy/values/common/common.values.yaml
      - deploy/values/common/api.values.yaml
      - deploy/values/{{ .Environment.Name }}/common.values.yaml
      - deploy/values/{{ .Environment.Name }}/api.values.yaml
    set:
      - name: environment
        value: {{ .Environment.Name }}
      - name: container.tag
        value: {{ printf "%v" (required "tag is required; pass --state-values-set tag=<value>" (index .Environment.Values "tag")) }}
    hooks:
      - events: ["prepare"]
        command: bash
        args:
          - -c
          - |
            set -e
            sops -d {{ .Environment.Values.secretsFile }} > charts/api/temp-secrets.yaml
      - events: ["cleanup"]
        command: bash
        args:
          - -c
          - |
            set -e
            rm -f charts/api/temp-secrets.yaml
            rm -f charts/api/Chart.lock
            rm -rf charts/api/charts

  - name: worker
    namespace: {{ .Environment.Values.namespace }}
    labels:
      svc: worker
    chart: ./charts/worker
    values:
      - deploy/values/common/common.values.yaml
      - deploy/values/common/worker.values.yaml
      - deploy/values/{{ .Environment.Name }}/common.values.yaml
      - deploy/values/{{ .Environment.Name }}/worker.values.yaml
    set:
      - name: environment
        value: {{ .Environment.Name }}
      - name: container.tag
        value: {{ printf "%v" (required "tag is required; pass --state-values-set tag=<value>" (index .Environment.Values "tag")) }}
    hooks:
      - events: ["prepare"]
        command: bash
        args:
          - -c
          - |
            set -e
            sops -d {{ .Environment.Values.secretsFile }} > charts/worker/temp-secrets.yaml
      - events: ["cleanup"]
        command: bash
        args:
          - -c
          - |
            set -e
            rm -f charts/worker/temp-secrets.yaml
            rm -f charts/worker/Chart.lock
            rm -rf charts/worker/charts
